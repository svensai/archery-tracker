# Flask session secret — change to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-very-long-random-string

# Optional: PostgreSQL connection string. Leave empty to use SQLite.
DATABASE_URL=

# Email (leave all empty to print verification links to console in development)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@archery.local

# Public base URL used inside verification and password-reset emails
BASE_URL=http://localhost:5001

# Set to true when running behind HTTPS to mark session cookies as Secure
HTTPS=false

# Flask debug mode — NEVER set to true in production
DEBUG=false
